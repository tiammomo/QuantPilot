{
  "version": 1,
  "modules": [
    {
      "id": "shared-kernel",
      "name": "共享内核",
      "summary": "跨模块稳定类型、配置、工具函数和无业务状态的基础能力。",
      "owner": "platform",
      "paths": [
        "src/types/**",
        "src/lib/config/**",
        "src/lib/utils.ts",
        "src/lib/runtime-degradation.ts",
        "src/lib/contracts/**",
        "src/lib/constants/**",
        "src/lib/crypto.ts",
        "src/lib/serializers/**",
        "src/lib/server/env-contract.ts",
        "src/lib/server/image-assets.ts",
        "src/lib/server/privileged-request.ts",
        "src/lib/server/websocket-manager.ts",
        "src/lib/utils/*.ts"
      ],
      "dependsOn": [],
      "publicSurface": [
        "@/lib/config/auth",
        "@/lib/config/constants",
        "@/lib/config/data-agent",
        "@/lib/config/degradation",
        "@/lib/config/llm",
        "@/lib/constants/cli",
        "@/lib/constants/models",
        "@/lib/contracts/agent-context-snapshot",
        "@/lib/contracts/agent-turn-metrics",
        "@/lib/crypto",
        "@/lib/serializers/chat",
        "@/lib/serializers/client/chat",
        "@/lib/serializers/project",
        "@/lib/server/env-contract",
        "@/lib/server/image-assets",
        "@/lib/server/privileged-request",
        "@/lib/server/websocket-manager",
        "@/lib/utils/api-response",
        "@/lib/utils/cliOptions",
        "@/lib/utils/index",
        "@/lib/utils/path",
        "@/lib/utils/ports",
        "@/types/backend/index",
        "@/types/cli",
        "@/types/index",
        "@/types/project",
        "@/types/shared/index"
      ]
    },
    {
      "id": "ui-kit",
      "name": "通用 UI 组件",
      "summary": "按钮、输入、弹窗、选择器等无领域知识的基础 UI。",
      "owner": "frontend-platform",
      "paths": [
        "src/components/ui/**",
        "src/contexts/ThemeContext.tsx"
      ],
      "dependsOn": [
        "shared-kernel"
      ],
      "publicSurface": [
        "@/components/ui/alert-dialog",
        "@/components/ui/badge",
        "@/components/ui/button",
        "@/components/ui/card",
        "@/components/ui/empty-state",
        "@/components/ui/input",
        "@/components/ui/label",
        "@/components/ui/select",
        "@/components/ui/sheet",
        "@/components/ui/skeleton",
        "@/components/ui/textarea",
        "@/components/ui/theme-toggle",
        "@/contexts/ThemeContext"
      ]
    },
    {
      "id": "platform-navigation-ui",
      "name": "平台导航 UI",
      "summary": "跨业务页面复用的页头、平台切换、子导航与路由加载状态。",
      "owner": "frontend-platform",
      "paths": [
        "src/components/layout/**",
        "src/components/auth/AuthUserMenu.tsx"
      ],
      "dependsOn": [
        "frontend-shared",
        "shared-kernel",
        "ui-kit"
      ],
      "publicSurface": [
        "@/components/auth/AuthUserMenu",
        "@/components/layout/PageHeader",
        "@/components/layout/PlatformRouteLoading",
        "@/components/layout/PlatformSwitcher",
        "@/components/layout/SubNav"
      ]
    },
    {
      "id": "product-shell",
      "name": "产品壳层",
      "summary": "首页、导航、布局、主题和平台入口编排。",
      "owner": "frontend-platform",
      "paths": [
        "src/app/page.tsx",
        "src/app/layout.tsx",
        "src/app/globals.css",
        "src/app/error.tsx",
        "src/app/global-error.tsx",
        "src/app/not-found.tsx",
        "src/components/theme/**",
        "src/app/**",
        "src/pages/**",
        "src/proxy.ts",
        "src/components/task/**",
        "src/components/account/**"
      ],
      "dependsOn": [
        "agent-runtime",
        "data-agent-core",
        "finance-domain",
        "frontend-shared",
        "identity-core",
        "ops-core",
        "persistence-core",
        "platform-core",
        "platform-navigation-ui",
        "quant-core",
        "shared-kernel",
        "ui-kit"
      ],
      "publicSurface": []
    },
    {
      "id": "platform-core",
      "name": "平台核心",
      "summary": "项目、设置、Token、服务目录、GitHub/Vercel 集成和工作空间基础状态。",
      "owner": "platform",
      "paths": [
        "src/lib/platform/**",
        "src/lib/services/project-services.ts",
        "src/lib/services/settings.ts",
        "src/lib/services/tokens.ts",
        "src/lib/services/git.ts",
        "src/lib/services/supabase.ts",
        "src/app/api/settings/**",
        "src/app/api/tokens/**",
        "src/app/api/infrastructure/**",
        "src/lib/integrations/**",
        "src/lib/server/api-idempotency*.ts"
      ],
      "dependsOn": [
        "identity-core",
        "persistence-core",
        "shared-kernel"
      ],
      "publicSurface": [
        "@/lib/integrations/github-repository",
        "@/lib/platform/context/integration-scope",
        "@/lib/platform/context/use-manifest",
        "@/lib/platform/knowledge/index",
        "@/lib/platform/knowledge/types",
        "@/lib/platform/memory/candidate",
        "@/lib/platform/memory/candidate-types",
        "@/lib/platform/memory/index",
        "@/lib/platform/service-catalog",
        "@/lib/server/api-idempotency",
        "@/lib/services/git",
        "@/lib/services/project-services",
        "@/lib/services/supabase",
        "@/lib/services/tokens"
      ],
      "migrationNotes": [
        "金融项目创建服务已归入 quant-core；后续新增通用 ProjectCatalog，不把默认 Domain Pack 写回平台核心。"
      ]
    },
    {
      "id": "agent-runtime",
      "name": "Agent 运行时",
      "summary": "开源 PI Agent 运行内核、多 Provider 适配、类型化工具、流式消息和技能编译。",
      "owner": "agent-platform",
      "paths": [
        "src/lib/services/agent-runtime.ts",
        "src/lib/services/message.ts",
        "src/lib/services/stream.ts",
        "src/lib/services/user-requests.ts",
        "src/lib/agent/**",
        "src/lib/services/pi-agent-candidate.ts",
        "src/lib/services/pi-agent-checkpoint*.ts",
        "src/lib/services/pi-agent-execution-error*.ts",
        "src/lib/services/pi-agent-generation-*.ts",
        "src/lib/services/pi-agent-worker-*.ts",
        "src/lib/services/pi-agent-mission-store*.ts",
        "src/lib/services/pi-agent-mission-verification-session*.ts",
        "src/lib/services/pi-agent-provenance*.ts",
        "src/lib/services/pi-agent-recovery*.ts",
        "src/lib/services/pi-agent-run-store*.ts",
        "src/lib/services/pi-agent-turn-metrics*.ts",
        "src/lib/services/pi-agent-tool-approval-store*.ts",
        "src/lib/services/terminal-callbacks.ts"
      ],
      "dependsOn": [
        "identity-core",
        "persistence-core",
        "shared-kernel"
      ],
      "publicSurface": [
        "@/lib/agent/context/index",
        "@/lib/agent/core/index",
        "@/lib/agent/core/tool-arguments",
        "@/lib/agent/framework-identity",
        "@/lib/agent/input-policy",
        "@/lib/agent/mission/index",
        "@/lib/agent/pi/run-engine",
        "@/lib/agent/providers/deepseek",
        "@/lib/agent/providers/deterministic-tool-plan",
        "@/lib/agent/providers/openai-compatible",
        "@/lib/agent/runtime/workspace-resource-lock",
        "@/lib/agent/skills/catalog-images",
        "@/lib/agent/skills/catalog-store",
        "@/lib/agent/skills/compatibility",
        "@/lib/agent/skills/index",
        "@/lib/agent/skills/workspace-install",
        "@/lib/agent/skills/workspace-integrity",
        "@/lib/agent/tools/errors",
        "@/lib/agent/tools/filesystem",
        "@/lib/agent/tools/index",
        "@/lib/agent/tools/input",
        "@/lib/agent/tools/path-policy",
        "@/lib/agent/tools/runtime",
        "@/lib/agent/types",
        "@/lib/services/agent-runtime",
        "@/lib/services/message",
        "@/lib/services/pi-agent-candidate",
        "@/lib/services/pi-agent-execution-error",
        "@/lib/services/pi-agent-generation-dispatch-session",
        "@/lib/services/pi-agent-generation-dispatch-store",
        "@/lib/services/pi-agent-generation-lease-session",
        "@/lib/services/pi-agent-generation-lease-store",
        "@/lib/services/pi-agent-mission-store",
        "@/lib/services/pi-agent-mission-verification-session",
        "@/lib/services/pi-agent-provenance",
        "@/lib/services/pi-agent-recovery",
        "@/lib/services/pi-agent-run-store",
        "@/lib/services/pi-agent-tool-approval-store",
        "@/lib/services/pi-agent-turn-metrics",
        "@/lib/services/stream",
        "@/lib/services/user-requests"
      ]
    },
    {
      "id": "data-agent-core",
      "name": "通用 Data Agent",
      "summary": "LLM-first 数据任务合同、Agent Profile、Domain Pack、Connector 与数据交付编排边界。",
      "owner": "data-agent-platform",
      "paths": [
        "src/lib/data-agent/**"
      ],
      "dependsOn": [
        "agent-runtime",
        "shared-kernel"
      ],
      "publicSurface": [
        "@/lib/data-agent/contracts",
        "@/lib/data-agent/index",
        "@/lib/data-agent/workspace-files",
        "@/lib/data-agent/workspace-layout",
        "@/lib/data-agent/workspace-path",
        "@/lib/data-agent/workspace-read"
      ]
    },
    {
      "id": "finance-domain",
      "name": "金融量化 Domain Pack",
      "summary": "金融能力目录、证券 Resolver、行情工具、金融 Mission 合同与金融可视化配置。",
      "owner": "quant-platform",
      "paths": [
        "src/lib/domains/finance/**",
        "src/lib/utils/scaffold-*.ts"
      ],
      "dependsOn": [
        "agent-runtime",
        "data-agent-core",
        "platform-core",
        "shared-kernel"
      ],
      "publicSurface": [
        "@/lib/domains/finance/agent-profile",
        "@/lib/domains/finance/agent-tools/dashboard-spec",
        "@/lib/domains/finance/agent-tools/factory",
        "@/lib/domains/finance/capabilities",
        "@/lib/domains/finance/data-identity",
        "@/lib/domains/finance/data-quality",
        "@/lib/domains/finance/evidence-quality",
        "@/lib/domains/finance/index",
        "@/lib/domains/finance/intent",
        "@/lib/domains/finance/query-rewrite",
        "@/lib/domains/finance/visualization-templates",
        "@/lib/domains/finance/workspace",
        "@/lib/domains/finance/workspace-artifacts",
        "@/lib/utils/scaffold-base-templates",
        "@/lib/utils/scaffold-config",
        "@/lib/utils/scaffold-dashboard-templates"
      ]
    },
    {
      "id": "quant-core",
      "name": "量化核心",
      "summary": "量化能力、策略、数据预取、工作空间证据、验证和技能治理。",
      "owner": "quant-platform",
      "paths": [
        "src/lib/quant/**",
        "src/lib/services/project.ts",
        "src/lib/services/env.ts",
        "src/lib/services/file-browser.ts",
        "src/lib/services/github.ts",
        "src/lib/services/preview.ts",
        "src/lib/services/service-integration.ts",
        "src/lib/services/vercel.ts",
        "src/lib/services/pi-agent-mission-control.ts",
        "src/lib/services/pi-agent-prompts*.ts",
        "src/lib/services/cli/**",
        "src/app/api/quant/**",
        "src/app/api/chat/**",
        "src/app/api/projects/**",
        "src/app/[project_id]/**",
        "src/app/api/research/**",
        "src/app/strategy-platform/**",
        "src/app/research-reports/**",
        "src/app/business-knowledge/**",
        "src/components/quant/skills-*.tsx",
        "src/components/quant/workspace-*.tsx",
        "src/components/quant/console-primitives.tsx",
        "src/components/chat/**",
        "src/lib/utils/scaffold*.ts",
        "src/lib/services/preview-stop-intent*.ts"
      ],
      "dependsOn": [
        "agent-runtime",
        "data-agent-core",
        "execution-isolation",
        "finance-domain",
        "frontend-shared",
        "identity-core",
        "persistence-core",
        "platform-core",
        "platform-navigation-ui",
        "shared-kernel",
        "ui-kit"
      ],
      "publicSurface": [
        "@/app/api/projects/[project_id]/memory/route-error",
        "@/components/chat/question-composer",
        "@/components/quant/console-primitives",
        "@/components/quant/skills-market",
        "@/components/quant/skills-source-tree",
        "@/components/quant/skills-version-manager-dialog",
        "@/components/quant/workspace-console-primitives",
        "@/lib/quant/capability-center",
        "@/lib/quant/generation-observability",
        "@/lib/quant/generation-state",
        "@/lib/quant/skills-admin",
        "@/lib/quant/skills-dashboard",
        "@/lib/quant/skills-deployment",
        "@/lib/quant/skills-management-api",
        "@/lib/quant/skills-market",
        "@/lib/quant/strategies",
        "@/lib/quant/validation/contracts",
        "@/lib/quant/validation/recovery",
        "@/lib/quant/validation/repair",
        "@/lib/quant/workspace-health",
        "@/lib/services/env",
        "@/lib/services/file-browser",
        "@/lib/services/github",
        "@/lib/services/project",
        "@/lib/services/vercel"
      ],
      "migrationNotes": [
        "strategies.ts 已拆出 strategy-types / strategy-catalog / strategy-scan-repository / strategy-readiness / strategy-mappers；StrategyPlatformClient 已拆出 helpers、FinancialKnowledgeView、UniverseView、StockKlineDetail、SectorCapitalFlowView、FactorCatalogView、FoundationView，后续继续拆 dialogs、hooks、market API client 和 dashboard service。"
      ]
    },
    {
      "id": "eval-core",
      "name": "评测核心",
      "summary": "评测集、用例、运行历史、评测器、报告和质量门。",
      "owner": "eval-platform",
      "paths": [
        "src/lib/eval/**",
        "src/app/eval-platform/**",
        "src/app/api/evals/**",
        "src/components/quant/eval-*.tsx",
        "scripts/evals/**",
        "scripts/checks/check-eval-*.js",
        "scripts/checks/check-quant-benchmark-coverage.js",
        "docs/evals-guide.md"
      ],
      "dependsOn": [
        "agent-runtime",
        "data-agent-core",
        "finance-domain",
        "identity-core",
        "persistence-core",
        "platform-navigation-ui",
        "quant-core",
        "shared-kernel",
        "ui-kit"
      ],
      "publicSurface": [],
      "migrationNotes": [
        "eval-core 已迁出 quant 目录；cases/sets、paths、runtime-utils 和 runtime-mappers 已拆分。runtime.ts 后续继续拆 runs / queue / repairs / scheduling。"
      ]
    },
    {
      "id": "ops-core",
      "name": "运维核心",
      "summary": "Docker、服务健康、基础设施、工作空间健康和可观测性入口。",
      "owner": "ops-platform",
      "paths": [
        "src/lib/ops/**",
        "src/app/ops-platform/**",
        "src/app/api/ops/**",
        "src/app/api/infrastructure/health/**",
        "src/app/api/observability/**",
        "src/components/quant/ops-*.tsx",
        "deploy/observability/**"
      ],
      "dependsOn": [
        "identity-core",
        "persistence-core",
        "platform-core",
        "platform-navigation-ui",
        "quant-core",
        "shared-kernel",
        "ui-kit"
      ],
      "publicSurface": [
        "@/lib/ops/readiness"
      ]
    },
    {
      "id": "market-data-backend",
      "name": "Python 市场数据后端",
      "summary": "FastAPI、行情 provider、TimescaleDB 事实库、Redis 缓存、ClickHouse 分析层和回测。",
      "owner": "backend-platform",
      "paths": [
        "services/market-data/**"
      ],
      "dependsOn": [],
      "publicSurface": [
        "services/market-data/src/quantpilot_market_data/routers"
      ],
      "migrationNotes": [
        "旧 database.py 兼容门面已删除；连接与转换工具只进入 database_core.py，业务 SQL 只进入对应 repository。"
      ]
    },
    {
      "id": "persistence-core",
      "name": "应用持久化",
      "summary": "Prisma 连接与应用 schema 就绪检查，不编排业务任务。",
      "owner": "platform",
      "paths": [
        "src/lib/db/**"
      ],
      "dependsOn": [],
      "publicSurface": [
        "@/lib/db/client",
        "@/lib/db/pi-agent-schema-readiness"
      ]
    },
    {
      "id": "identity-core",
      "name": "身份与配额",
      "summary": "认证、授权、权限和用量配额的服务端合同。",
      "owner": "platform",
      "paths": [
        "src/lib/auth/**",
        "src/lib/quota/**"
      ],
      "dependsOn": [
        "persistence-core",
        "shared-kernel"
      ],
      "publicSurface": [
        "@/lib/auth/access",
        "@/lib/auth/access-management",
        "@/lib/auth/action",
        "@/lib/auth/audit",
        "@/lib/auth/authorization",
        "@/lib/auth/client",
        "@/lib/auth/http",
        "@/lib/auth/login-identity",
        "@/lib/auth/password",
        "@/lib/auth/permissions",
        "@/lib/auth/project-route-action",
        "@/lib/auth/server",
        "@/lib/quota/allocation-reconciliation",
        "@/lib/quota/defaults",
        "@/lib/quota/index",
        "@/lib/quota/service"
      ]
    },
    {
      "id": "execution-isolation",
      "name": "执行隔离",
      "summary": "生成代码的运行环境过滤与 Linux namespace 沙箱适配。",
      "owner": "agent-platform",
      "paths": [
        "src/lib/security/**"
      ],
      "dependsOn": [],
      "publicSurface": [
        "@/lib/security/generated-project-sandbox"
      ]
    },
    {
      "id": "frontend-shared",
      "name": "共享前端状态与设置",
      "summary": "跨页面复用的浏览器状态、账号、设置和交互组件。",
      "owner": "frontend-platform",
      "paths": [
        "src/contexts/**",
        "src/hooks/**",
        "src/components/settings/**",
        "src/components/modals/**",
        "src/components/auth/**",
        "src/components/ErrorBoundary.tsx",
        "src/lib/motion.ts",
        "src/lib/chat/**"
      ],
      "dependsOn": [
        "identity-core",
        "platform-core",
        "shared-kernel"
      ],
      "publicSurface": [
        "@/components/ErrorBoundary",
        "@/components/settings/GlobalSettings",
        "@/components/settings/ProjectSettings",
        "@/contexts/AuthContext",
        "@/contexts/GlobalSettingsContext",
        "@/hooks/useCLI",
        "@/hooks/useUserRequests",
        "@/hooks/useWebSocket",
        "@/lib/chat/chat-message-runtime",
        "@/lib/chat/tool-activity",
        "@/lib/motion"
      ]
    }
  ],
  "rules": {
    "forbiddenImports": [
      {
        "from": "src/lib/**",
        "to": "src/app/**",
        "reason": "领域和服务层不能反向依赖 Next.js 页面。"
      },
      {
        "from": "src/components/ui/**",
        "to": "src/app/**",
        "reason": "通用 UI 不能依赖页面层。"
      },
      {
        "from": "src/components/ui/**",
        "to": "src/lib/quant/**",
        "reason": "通用 UI 不能携带量化领域知识。"
      },
      {
        "from": "src/components/ui/**",
        "to": "src/lib/services/**",
        "reason": "通用 UI 不能直接依赖运行时服务。"
      },
      {
        "from": "src/components/ui/**",
        "to": "src/lib/ops/**",
        "reason": "通用 UI 不能直接依赖运维领域。"
      },
      {
        "from": "src/lib/agent/**",
        "to": "src/lib/quant/**",
        "reason": "PI Agent Framework 不能依赖金融应用核心。"
      },
      {
        "from": "src/lib/agent/**",
        "to": "src/lib/domains/**",
        "reason": "PI Agent Framework 不能依赖业务 Domain Pack。"
      },
      {
        "from": "src/lib/agent/**",
        "to": "src/lib/data-agent/**",
        "reason": "PI Agent Framework 是 Data Agent 的下层运行时，不能反向依赖。"
      },
      {
        "from": "src/lib/data-agent/**",
        "to": "src/lib/quant/**",
        "reason": "通用 Data Agent 不能依赖金融应用实现。"
      },
      {
        "from": "src/lib/data-agent/**",
        "to": "src/lib/domains/**",
        "reason": "通用 Data Agent 只能消费注册合同，不能反向依赖具体 Domain Pack。"
      },
      {
        "from": "src/lib/domains/finance/**",
        "to": "src/lib/quant/**",
        "reason": "Finance Domain Pack 不能反向依赖 QuantPilot 产品编排层。"
      },
      {
        "from": "services/market-data/**",
        "to": "src/**",
        "reason": "Python 后端不能依赖 Next.js 前端源码。"
      }
    ],
    "removedPaths": [
      {
        "path": "src/app/api/chat/**/active-session/**",
        "reason": "运行身份只由 Mission 和 AgentRun 管理，不恢复旧 active-session API。"
      },
      {
        "path": "src/app/api/chat/**/sessions/**/status/**",
        "reason": "运行状态只从 generation/status 和 Mission 存储读取。"
      },
      {
        "path": "src/lib/services/chat-sessions.*",
        "reason": "旧聊天 session 服务已经被 durable Mission 生命周期替代。"
      },
      {
        "path": "src/app/api/chat/**/cli-preference/**",
        "reason": "模型选择只通过项目当前合同持久化，不恢复平行偏好 API。"
